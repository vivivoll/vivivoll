АЛГОРИТМ ДИНАМИЧЕСКИЙ_БУФЕР()
НАЧАЛО
    ЦЕЛОЕ емкость = 1
    ЦЕЛОЕ размер = 0
    ЦЕЛОЕ число = 0

    цел_указатель буфер = ВЫДЕЛИТЬ_ПАМЯТЬ(емкость)

    ВЫВЕСТИ("Введите числа:")
    ВВОД(число)

    ПОКА (число != -1) ДЕЛАТЬ
        
        ЕСЛИ (размер == емкость) ТО
            емкость = емкость * 2
            
            цел_указатель новый_буфер = ВЫДЕЛИТЬ_ПАМЯТЬ(емкость)
            
            ДЛЯ i ОТ 0 ДО (размер - 1) ДЕЛАТЬ
                ЗНАЧЕНИЕ(новый_буфер + i) = ЗНАЧЕНИЕ(буфер + i)
            КОНЕЦ ДЛЯ
            
            ОСВОБОДИТЬ_ПАМЯТЬ(буфер)
            буфер = новый_буфер
        КОНЕЦ ЕСЛИ

        ЗНАЧЕНИЕ(буфер + размер) = число
        размер = размер + 1

        ВВОД(число)
    КОНЕЦ ПОКА

    ВЫВЕСТИ("Содержимое буфера:")
    ДЛЯ i ОТ 0 ДО (размер - 1) ДЕЛАТЬ
        ВЫВЕСТИ(ЗНАЧЕНИЕ(буфер + i))
    КОНЕЦ ДЛЯ

    ОСВОБОДИТЬ_ПАМЯТЬ(буфер)
    буфер = NULL
КОНЕЦ
