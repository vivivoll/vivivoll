использовать Математика

алг Вычисления
нач
  вещ a, b, c
  вещ ср_арифм, ср_геом, макс_мод
  
  a := 4
  b := 9
  c := -16
  
  ср_арифм := (a + b + c) / 3
  ср_геом := (abs(a * b * c)) ** (1/3) | кубический корень через степень
  
  макс_мод := макс(abs(a), abs(b))
  макс_мод := макс(макс_мод, abs(c))
  
  вывод "среднее арифм. = ", ср_арифм, нс
  вывод "среднее геом. = ", ср_геом, нс
  вывод "макс. по модулю = ", макс_мод, нс
кон
