использовать Файлы

алг Задача_8
нач
  файл f1, f2
  строка имя, группа, лучш_имя, лучш_группа
  вещ балл, лучш_балл
  
  f1 := открыть на запись("students.txt")
  вывод f1, "Иванов", " ", "Э-01", " ", 4.8, нс
  вывод f1, "Петров", " ", "Э-01", " ", 4.2, нс
  вывод f1, "Сидоров", " ", "М-02", " ", 4.6, нс
  закрыть(f1)
  
  f1 := открыть на чтение("students.txt")
  f2 := открыть на запись("filtered.txt")
  
  лучш_балл := -1.0
  
  нц пока не конец файла(f1)
    ввод f1, имя, группа, балл
    если балл > лучш_балл то
      лучш_балл := балл; лучш_имя := имя; лучш_группа := группа
    все
    если балл > 4.5 то
      вывод f2, имя, " ", группа, " ", балл, нс
    все
  кц
  
  закрыть(f1); закрыть(f2)
  вывод "Лучший студент: ", лучш_имя, " ", лучш_балл, нс
кон
