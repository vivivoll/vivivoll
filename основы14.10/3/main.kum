алг Задача_3
нач
  цел d, m, y
  цел td, tm, ty
  цел полных_лет, дней_до_др
  цел c, ya, w
  строка день_нед
  
  td := 8; tm := 10; ty := 2026
  
  вывод "Введите день, месяц, год рождения: "
  ввод d, m, y
  
  цел q, mm, yy
  q := d
  если m < 3 то
    mm := m + 12
    yy := y - 1
  иначе
    mm := m
    yy := y
  все
  w := (q + 13*(mm+1) div 5 + yy + yy div 4 - yy div 100 + yy div 400) мод 7
  
  если w=0 то день_нед := "суббота" все
  если w=1 то день_нед := "воскресенье" все
  если w=2 то день_нед := "понедельник" все
  если w=3 то день_нед := "вторник" все
  если w=4 то день_нед := "среда" все
  если w=5 то день_нед := "четверг" все
  если w=6 то день_нед := "пятница" все
  
  полных_лет := ty - y
  если (tm < m) или (tm = m и td < d) то
    полных_лет := полных_лет - 1
  все
  
  цел дней_рождения, дней_текущих
  дней_рождения := m * 30 + d
  дней_текущих := tm * 30 + td
  
  если дней_рождения > дней_текущих то
    дней_до_др := дней_рождения - дней_текущих
  иначе
    дней_до_др := 365 - (дней_текущих - дней_рождения)
  все
  
  вывод "День недели: ", день_нед, нс
  вывод "Полных лет: ", полных_лет, нс
  вывод "Дней до следующего ДР: ", дней_до_др, нс
кон
