использовать Строки

алг Задача_6
нач
  строка s, подстр, рез_замена, рез_реверс
  цел i, п
  
  вывод "Введите строку: "
  ввод s
  
  вывод "Длина: ", длин(s), нс
  вывод "Верхний регистр: ", врег(s), нс
  
  подстр := "г"
  п := поз(подстр, s)
  вывод "Позиция 'г': ", п, нс
  
  рез_замена := ""
  нц для i от 1 до длин(s)
    если s[i] = "а" то
      рез_замена := рез_замена + "*"
    иначе
      рез_замена := рез_замена + s[i]
    все
  кц
  вывод "Замена: ", рез_замена, нс
  
  рез_реверс := ""
  нц для i от длин(s) шаг -1 до 1
    рез_реверс := рез_реверс + s[i]
  кц
  вывод "Реверс: ", рез_реверс, нс
кон
