использовать Математика

алг Задача_5
нач
  целтаб масс[1:20]
  цел i, j, вв, ключ, четные
  лог найдено
  
  четные := 0
  вывод "Исходный: "
  нц для i от 1 до 20
    масс[i] := случ_между(1, 100)
    вывод maсс[i], " "
    если мод(масс[i], 2) = 0 то четные := четные + 1 все
  кц
  нс
  
  вывод "Введите число для поиска: "
  ввод ключ
  
  найдено := нет
  нц для i от 1 до 20
    если масс[i] = ключ то найдено := да все
  кц
  
  если найдено то вывод "Число найдено", нс иначе вывод "Число не найдено", нс все
  вывод "Количество четных: ", четные, нс
  
  нц для i от 1 до 19
    нц для j от 1 до 20-i
      если масс[j] > масс[j+1] то
        вв := масс[j]; масс[j] := масс[j+1]; масс[j+1] := вв
      все
    кц
  кц
  
  вывод "Отсортированный: "
  нц для i от 1 до 20
    вывод масс[i], " "
  кц
  нс
кон
