алг Задача_7
нач
  строкатекст
  текст := "мама мыла раму мама"
  
  строкатаб слова[1:10]
  целтаб частота[1:10]
  цел n, i, j, k
  строка тек_слово, вв_с
  цел вв_ч
  
  n := 0
  тек_слово := ""
  
  нц для i от 1 до длин(текст)
    если текст[i] = " " то
      если длин(тек_слово) > 0 то
        лог найдено; найдено := нет
        нц для k от 1 до n
          если слова[k] = тек_слово то
            частота[k] := частота[k] + 1; найдено := да
          все
        кц
        если не найдено то
          n := n + 1; слова[n] := тек_слово; частота[n] := 1
        все
        тек_слово := ""
      все
    иначе
      тек_слово := тек_слово + текст[i]
    все
  кц
  
  если длин(тек_слово) > 0 то
    лог найдено; найдено := нет
    нц для k от 1 до n
      если слова[k] = тек_слово то
        частота[k] := частота[k] + 1; найдено := да
      все
    кц
    если не найдено то
      n := n + 1; слова[n] := тек_слово; частота[n] := 1
    все
  все

  нц для i от 1 до n
    вывод слова[i], ": ", частота[i], нс
  кц

  нц для i от 1 до n-1
    нц для j от 1 до n-i
      если частота[j] < частота[j+1] то
        вв_с := слова[j]; слова[j] := слова[j+1]; слова[j+1] := вв_с
        вв_ч := частота[j]; частота[j] := частота[j+1]; частота[j+1] := вв_ч
      все
    кц
  кц

  вывод "Самые частые: ", слова, ", ", слова, ", ", слова, нс
кон
