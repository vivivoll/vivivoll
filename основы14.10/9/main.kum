алг Задача_9
нач
  целтаб т[1:7]
  цел i, j, сума, мин, макс
  сума := 0; мин := 99; макс := -99
  
  нц для i от 1 до 7
    т[i] := случ_между(-20, 35)
    сума := сума + т[i]
    если т[i] < мин то мин := т[i] все
    если т[i] > макс то макс := т[i] все
  кц
  
  вывод "Статистика: Средняя=", сума/7, " Мин=", мин, " Макс=", макс, нс
  
  нц для i от 1 до 7
    вывод "День ", i, ": "
    нц для j от 1 до т[i] + 20
      вывод "#"
    кц
    вывод " (", т[i], ")", нс
  кц
кон
