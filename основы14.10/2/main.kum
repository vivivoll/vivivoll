алг Задача_2
нач
  целтаб масс[1:15]
  цел i, сумма_пол, кол_отр, мин, макс
  
  сумма_пол := 0
  кол_отр := 0
  
  вывод "Исходный массив: "
  нц для i от 1 до 15
    масс[i] := случ_между(-30, 30)
    вывод масс[i], " "
  кц
  нс
  
  мин := масс[1]
  макс := масс[1]
  
  нц для i от 1 до 15
    если масс[i] > 0 то
      сумма_пол := сумма_пол + масс[i]
    все
    если масс[i] < 0 то
      кол_отр := кол_отр + 1
    все
    если масс[i] < мин то
      мин := масс[i]
    все
    если масс[i] > макс то
      макс := масс[i]
    все
  кц
  
  вывод "Сумма положительных: ", сумма_пол, нс
  вывод "Количество отрицательных: ", кол_отр, нс
  вывод "Минимальный элемент: ", мин, нс
  вывод "Максимальный элемент: ", макс, нс
кон
