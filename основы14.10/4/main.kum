алг Задача_4
нач
  целтаб оценки[1:15]
  цел i, n, мода, макс_частота, текущая_частота
  вещ ср_арифм, медиана, ст_откл, сумма, сумма_квадратов
  
  оценки[1]:=5; оценки[2]:=4; оценки[3]:=4; оценки[4]:=3; оценки[5]:=5
  оценки[6]:=5; оценки[7]:=4; оценки[8]:=2; оценки[9]:=3; оценки[10]:=5
  оценки[11]:=4; оценки[12]:=4; оценки[13]:=5; оценки[14]:=3; оценки[15]:=4
  n := 15
  
  сумма := 0
  нц для i от 1 до n
    сумма := сумма + оценки[i]
  кц
  ср_арифм := сумма / n
  
  цел j, вв
  нц для i от 1 до n-1
    нц для j от 1 до n-i
      если оценки[j] > оценки[j+1] то
        вв := оценки[j]
        оценки[j] := оценки[j+1]
        оценки[j+1] := вв
      все
    кц
  кц
  
  если мод(n, 2) = 0 то
    медиана := (оценки[n div 2] + оценки[n div 2 + 1]) / 2
  иначе
    медиана := оценки[n div 2 + 1]
  все
  
  мода := оценки[1]
  макс_частота := 1
  текущая_частота := 1
  нц для i от 2 до n
    если оценки[i] = оценки[i-1] то
      текущая_частота := текущая_частота + 1
    иначе
      если текущая_частота > макс_частота то
        макс_частота := текущая_частота
        мода := оценки[i-1]
      все
      текущая_частота := 1
    все
  кц
  если текущая_частота > макс_частота то
    мода := оценки[n]
  все
  
  сумма_квадратов := 0
  нц для i от 1 до n
    сумма_квадратов := сумма_квадратов + (оценки[i] - ср_арифм)**2
  кц
  ст_откл := sqrt(сумма_квадратов / (n - 1))
  
  вывод "Среднее арифметическое: ", ср_арифм, нс
  вывод "Медиана: ", медиана, нс
  вывод "Мода: ", мода, нс
  вывод "Стандартное отклонение: ", ст_откл, нс
кон
