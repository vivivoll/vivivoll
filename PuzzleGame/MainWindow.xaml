<Window x:Class="PuzzleGame.MainWindow" Background="#1E293B"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="Пазл"
        Height="400"
        Width="300">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            
            <Button Content="Выбрать картинку"
                    Width="220"
                    Height="40"
                    Margin="10"
                    Click="ChooseImage_Click"/>

            <TextBlock Name="tbImage"
                    Text="Картинка не выбрана"
                    Foreground="White"
                    Margin="10"
                    HorizontalAlignment="Center"/>

            <Button Content="3 x 3"
                    Height="40"
                    Margin="10"
                    Click="Btn3_Click"/>

            <Button Content="4 x 4"
                    Height="40"
                    Margin="10"
                    Click="Btn4_Click"/>

            <Button Content="5 x 5"
                    Height="40"
                    Margin="10"
                    Click="Btn5_Click"/>

            <Button Content="Рекорды"
                    Height="40"
                    Margin="10"
                    Click="Records_Click"/>

        </StackPanel>
    </Grid>
</Window> 